# PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/eng_moaaz?schema=public"

# Session security: use a long random secret in production
AUTH_SECRET="replace-with-a-long-random-secret"

# Payment webhook signing secret
PAYMENT_WEBHOOK_SECRET="replace-with-a-long-random-secret"

# Token encryption key used for OAuth refresh tokens; keep this secret
TOKEN_ENCRYPTION_KEY="replace-with-a-32-byte-secret"

# Super Admin: the one account that has global site/admin governance
SUPER_ADMIN_PHONE="01XXXXXXXXX"
SUPER_ADMIN_PASSWORD="set-a-strong-password-for-bootstrap"

# Public canonical site URL used for SEO/sitemap/OAuth redirects
NEXT_PUBLIC_SITE_URL="https://eng-moaaz.vercel.app"

# YouTube / Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="https://eng-moaaz.vercel.app/api/admin/youtube/callback"

# Optional payment provider credentials (enable when an online gateway is connected)
PAYMENT_PROVIDER="MANUAL"
PAYMENT_PUBLIC_KEY=""
PAYMENT_SECRET_KEY=""
